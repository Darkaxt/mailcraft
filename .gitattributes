# Text is kept with LF line ends in the repository. What a shell or a packaging tool reads keeps
# them in every checkout too (a script with CRLF line ends doesn't run).
* text=auto
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.desktop text eol=lf
*.xml text eol=lf
*.in text eol=lf
*.py text eol=lf
*.plist text eol=lf
*.png binary
*.ico binary
*.icns binary
*.ttf binary
*.po text eol=lf
*.pot text eol=lf

# Retain source-import byte identities across Windows checkouts and recovery stashes.
vendor/winit/** -text
# Messages that are test vectors are kept byte for byte: a Digital signature covers their CRLF line ends.
crates/smime/testdata/** binary
fuzz/seeds/smime/** binary
vendor/cosca/** -text

# The native runtime is source-bound by byte hashes on every packaging host.
native/craft-content/sources.json text eol=lf
native/craft-content/ocr-sources.json text eol=lf
native/craft-content/worker.rs text eol=lf
native/craft-content/extraction.rs text eol=lf
native/craft-content/release-runtime.json text eol=lf
crates/craft-content/src/lib.rs text eol=lf
crates/craft-content/src/paging.rs text eol=lf
crates/craft-content/src/protocol.rs text eol=lf
